# mnemory environment for the system-scope mnemory.service unit.
#
# Install location: /etc/workstation/mnemory.env
# Owner: root:root, mode 0640
# Sourced by: systemd/mnemory.service (EnvironmentFile)
#
# This file holds the per-host mnemory configuration:
# - LLM and embeddings endpoints (point at the local sidecars)
# - The user-API-key mapping (binds keys to user_ids)
#
# Generation: scripts/install-mnemory-env.sh writes this from your
# existing ~/.config/mnemory/keys (which earlier `start-mnemory.sh` runs
# generated). To install:
#
#   sudo install -m 0640 -o root -g root \
#     configs/workstation/mnemory.env.example /etc/workstation/mnemory.env
#   sudo $EDITOR /etc/workstation/mnemory.env  # paste real keys
#
# The MCP_API_KEYS JSON is the only secret here. Treat this file like
# any other env-with-secrets — gitignore covers configs/workstation/
# but not /etc/workstation/.

# ── LLM (chat completions for fact extraction) ────────────────────────────
# llama-secondary serves qwen3-4b-instruct-2507 on port 11435.
LLM_BASE_URL=http://127.0.0.1:11435/v1
LLM_API_KEY=local-no-auth
LLM_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LLM_REASONING_EFFORT=low

# ── Embeddings (1024-dim multilingual-e5-large) ───────────────────────────
# llama-embed on port 11437. EMBED_DIMS critical: e5-large emits 1024
# dims, NOT OpenAI's default 1536. Mismatch silently rejects writes.
EMBED_BASE_URL=http://127.0.0.1:11437/v1
EMBED_API_KEY=local-no-auth
EMBED_MODEL=multilingual-e5-large-Q8_0.gguf
EMBED_DIMS=1024

# ── Vector store ──────────────────────────────────────────────────────────
# Embedded Qdrant in $HOME/.mnemory/qdrant/. Leave QDRANT_HOST unset.

# ── Multi-user authentication ─────────────────────────────────────────────
# JSON map of API key → user_id. Generate keys with `openssl rand -hex 32`
# and paste here. The plugin (and any other client) uses one of these keys
# in MNEMORY_API_KEY; mnemory authenticates and binds the request to the
# matching user_id, namespacing memories per user.
#
# Format: {"<api-key>": "<user-id>", ...}
# Example (REPLACE with real keys before installing):
MCP_API_KEYS={"REPLACE_WITH_LEVINE_KEY":"levine","REPLACE_WITH_ANNY_KEY":"anny"}
