[Unit]
Description=mnemory persistent memory server (qwen3-4b for extraction, e5-large for embeddings, embedded Qdrant, port 8050)
# Reads config from /etc/workstation/mnemory.env (LLM/embed endpoints,
# MCP_API_KEYS user-mapping). Data at $HOME/.mnemory/ (Qdrant collection,
# SQLite session state, filesystem artifacts).
#
# Runs as the user who installed the stack. The User/Group/HOME/PATH/
# ExecStart fields below contain placeholders rendered at install-time
# by scripts/install-systemd-units.sh from the invoking $USER, $HOME,
# and the resolved path to `uvx`. The unit shipped in the repo does
# NOT work as-is; install via the script.
#
# A future revision may migrate to a dedicated 'mnemory' system user
# for cleaner isolation; for now this is colocated with the launcher
# user's uvx install and data dir.

[Service]
Type=simple
User=__WS_USER__
Group=__WS_USER__
EnvironmentFile=/etc/workstation/mnemory.env
Environment="PATH=__WS_USER_LOCAL_BIN__:/usr/local/bin:/usr/bin:/bin"
Environment="HOME=__WS_USER_HOME__"
WorkingDirectory=__WS_USER_HOME__

ExecStart=__WS_UVX__ mnemory

Restart=on-failure
RestartSec=10s
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
