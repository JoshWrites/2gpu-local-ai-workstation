```python
import time
from functools import wraps
from collections import deque

def rate_limit(max_calls, period_seconds):
    """
    A decorator that limits how often the wrapped function can be called.
    
    Args:
        max_calls (int): Maximum number of calls allowed in the period
        period_seconds (float): Time window in seconds
        
    Returns:
        callable: Decorator function
    """
    def decorator(func):
        # Store the call history for this specific function
        call_history = deque()
        
        @wraps(func)
        def wrapper(*args, **kwargs):
            current_time = time.time()
            
            # Remove calls that are outside the current period
            while call_history and call_history[0] <= current_time - period_seconds:
                call_history.popleft()
            
            # If we've reached the limit, wait until we can make another call
            if len(call_history) >= max_calls:
                sleep_time = period_seconds - (current_time - call_history[0])
                if sleep_time > 0:
                    time.sleep(sleep_time)
                # Remove the oldest call after waiting
                call_history.popleft()
            
            # Make the function call
            result = func(*args, **kwargs)
            
            # Record this call
            call_history.append(current_time)
            
            return result
        
        return wrapper
    return decorator
